generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AgentStatus {
  ACTIVE
  REVOKED
}

enum CheckInLinkStatus {
  ACTIVE
  REVOKED
}

enum AccessScanOutcome {
  ACCEPTED
  DUPLICATE
  REJECTED
  UNAVAILABLE
}

model CheckInAgent {
  id           String                  @id @default(uuid()) @db.Uuid
  ownerSubject String                  @map("owner_subject") @db.VarChar(255)
  eventId      String                  @map("event_id") @db.Uuid
  agentSubject String                  @map("agent_subject") @db.VarChar(255)
  status       AgentStatus             @default(ACTIVE)
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  ceremonies   AgentCeremonyGrant[]
  scans        AccessScanAttempt[]

  @@unique([eventId, agentSubject], map: "checkin_agents_event_subject_key")
  @@index([ownerSubject, eventId, status], map: "checkin_agents_owner_event_status_idx")
  @@map("checkin_agents")
}

model AgentCeremonyGrant {
  id           String       @id @default(uuid()) @db.Uuid
  agentId      String       @map("agent_id") @db.Uuid
  ownerSubject String       @map("owner_subject") @db.VarChar(255)
  eventId      String       @map("event_id") @db.Uuid
  ceremonyId   String       @map("ceremony_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  agent        CheckInAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, ceremonyId], map: "agent_ceremony_grants_agent_ceremony_key")
  @@index([ownerSubject, eventId, ceremonyId], map: "agent_ceremony_grants_owner_event_ceremony_idx")
  @@map("agent_ceremony_grants")
}

model AccessScanAttempt {
  id                String            @id @default(uuid()) @db.Uuid
  ownerSubject      String            @map("owner_subject") @db.VarChar(255)
  eventId           String            @map("event_id") @db.Uuid
  ceremonyId        String            @map("ceremony_id") @db.Uuid
  operatorSubject   String            @map("operator_subject") @db.VarChar(255)
  agentId           String?           @map("agent_id") @db.Uuid
  linkId            String?           @map("link_id") @db.Uuid
  deviceFingerprint String?           @map("device_fingerprint") @db.Char(64)
  userAgent         String?           @map("user_agent") @db.VarChar(300)
  outcome           AccessScanOutcome
  upstreamStatus    Int               @map("upstream_status") @db.SmallInt
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  agent             CheckInAgent?     @relation(fields: [agentId], references: [id], onDelete: SetNull)
  link              CheckInLink?      @relation(fields: [linkId], references: [id], onDelete: SetNull)

  @@index([ownerSubject, eventId, ceremonyId, createdAt(sort: Desc)], map: "access_scan_attempts_owner_event_ceremony_created_idx")
  @@index([agentId, createdAt(sort: Desc)], map: "access_scan_attempts_agent_created_idx")
  @@index([linkId, createdAt(sort: Desc)], map: "access_scan_attempts_link_created_idx")
  @@map("access_scan_attempts")
}

model CheckInLink {
  id          String            @id @default(uuid()) @db.Uuid
  ownerSubject String           @map("owner_subject") @db.VarChar(255)
  eventId     String            @map("event_id") @db.Uuid
  eventName   String            @map("event_name") @db.VarChar(120)
  timezone    String            @db.VarChar(100)
  label       String?           @db.VarChar(120)
  reference   String            @db.VarChar(140)
  tokenHash   String            @unique @map("token_hash") @db.Char(64)
  tokenCiphertext String?       @map("token_ciphertext") @db.Text
  status      CheckInLinkStatus @default(ACTIVE)
  expiresAt   DateTime          @map("expires_at") @db.Timestamptz(3)
  lastUsedAt  DateTime?         @map("last_used_at") @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  licenseId   String?           @map("license_id") @db.Uuid
  license     CheckInLicense?   @relation(fields: [licenseId], references: [id], onDelete: Restrict)
  ceremonies  CheckInLinkCeremonyGrant[]
  scans       AccessScanAttempt[]

  @@index([ownerSubject, eventId, status, createdAt(sort: Desc)], map: "checkin_links_owner_event_status_created_idx")
  @@map("checkin_links")
}

enum CheckInLicenseSource {
  PERSONAL
  AGENCY
}

enum CheckInLicenseStatus {
  UNASSIGNED
  ACTIVE
  REVOKED
}

model CheckInLicense {
  id              String               @id @default(uuid()) @db.Uuid
  source          CheckInLicenseSource
  status          CheckInLicenseStatus @default(UNASSIGNED)
  ownerSubject    String               @map("owner_subject") @db.VarChar(255)
  sourceReference String               @unique @map("source_reference") @db.VarChar(255)
  eventId         String?              @unique @map("event_id") @db.Uuid
  guestCapacity   Int                  @map("guest_capacity")
  usedGuestCount  Int                  @default(0) @map("used_guest_count")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  assignedAt      DateTime?            @map("assigned_at") @db.Timestamptz(3)
  links           CheckInLink[]
  guests          CheckInLicenseGuest[]
  @@index([ownerSubject, source, status], map: "checkin_licenses_owner_status_idx")
  @@map("checkin_licenses")
}

model CheckInLicenseGuest {
  licenseId  String   @map("license_id") @db.Uuid
  tokenHash  String   @map("token_hash") @db.Char(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  license    CheckInLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  @@id([licenseId, tokenHash])
  @@map("checkin_license_guests")
}

model CheckInLinkCeremonyGrant {
  id           String      @id @default(uuid()) @db.Uuid
  linkId       String      @map("link_id") @db.Uuid
  ceremonyId   String      @map("ceremony_id") @db.Uuid
  ceremonyName String      @map("ceremony_name") @db.VarChar(120)
  startAt      DateTime    @map("start_at") @db.Timestamptz(3)
  expiresAt    DateTime    @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  link         CheckInLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, ceremonyId], map: "checkin_link_ceremony_grants_link_ceremony_key")
  @@index([ceremonyId, expiresAt], map: "checkin_link_ceremony_grants_ceremony_expiry_idx")
  @@map("checkin_link_ceremony_grants")
}

model OutboxMessage {
  id          String   @id @default(uuid()) @db.Uuid
  eventType   String   @map("event_type") @db.VarChar(100)
  aggregateId String   @map("aggregate_id") @db.Uuid
  payload     Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  attempts    Int      @default(0)

  @@index([publishedAt, createdAt], map: "access_outbox_pending_idx")
  @@map("outbox_messages")
}
