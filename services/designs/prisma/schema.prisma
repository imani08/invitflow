generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TemplateCategory {
  WEDDING
  BIRTHDAY
  GRADUATION
  BAPTISM
  BABY_SHOWER
  GALA
  CONFERENCE
}

enum DesignStatus {
  DRAFT
  ARCHIVED
}

model DesignTemplate {
  id          String           @id @default(uuid()) @db.Uuid
  slug        String           @unique @db.VarChar(100)
  version     Int              @default(1)
  name        String           @db.VarChar(120)
  description String           @db.VarChar(500)
  category    TemplateCategory
  style       String           @db.VarChar(60)
  tags        String[]
  preview     Json
  document    Json
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  designs     Design[]
  versions    DesignTemplateVersion[]

  @@index([category, isActive, name], map: "design_templates_catalog_idx")
  @@map("design_templates")
}

model DesignTemplateVersion {
  templateId   String   @map("template_id") @db.Uuid
  version      Int
  ceremonyTypes String[] @map("ceremony_types")
  document     Json
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  template     DesignTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([templateId, version], map: "design_template_versions_pkey")
  @@index([ceremonyTypes], type: Gin, map: "design_template_versions_ceremony_types_idx")
  @@map("design_template_versions")
}

model Design {
  id            String          @id @default(uuid()) @db.Uuid
  ownerSubject  String          @map("owner_subject") @db.VarChar(255)
  eventId       String          @map("event_id") @db.Uuid
  templateId    String?         @map("template_id") @db.Uuid
  templateSlug  String?         @map("template_slug") @db.VarChar(100)
  name          String          @db.VarChar(120)
  status        DesignStatus    @default(DRAFT)
  version       Int             @default(1)
  document      Json
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  template      DesignTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  versions      DesignVersion[]

  @@index([ownerSubject, eventId, updatedAt(sort: Desc)], map: "designs_owner_event_updated_idx")
  @@map("designs")
}

model DesignVersion {
  id        String   @id @default(uuid()) @db.Uuid
  designId  String   @map("design_id") @db.Uuid
  version   Int
  document  Json
  name      String   @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  design    Design   @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@unique([designId, version], map: "design_versions_design_version_key")
  @@index([designId, createdAt(sort: Desc)], map: "design_versions_design_created_idx")
  @@map("design_versions")
}

model OutboxMessage {
  id          String    @id @default(uuid()) @db.Uuid
  eventType   String    @map("event_type") @db.VarChar(100)
  aggregateId String    @map("aggregate_id") @db.Uuid
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  attempts    Int       @default(0)

  @@index([publishedAt, createdAt], map: "designs_outbox_pending_idx")
  @@map("outbox_messages")
}
