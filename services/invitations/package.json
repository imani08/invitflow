{
    "name":  "@invitaflow/invitations",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "dev":  "pnpm prisma:generate \u0026\u0026 pnpm prisma:migrate:deploy \u0026\u0026 tsx watch src/main.ts",
                    "build":  "pnpm prisma:generate \u0026\u0026 tsc -p tsconfig.json \u0026\u0026 node -e \"const fs=require(\u0027fs\u0027); fs.mkdirSync(\u0027dist/src\u0027,{recursive:true}); fs.readdirSync(\u0027src\u0027).filter(f=\u003ef.endsWith(\u0027.mjs\u0027)).forEach(f=\u003efs.copyFileSync(\u0027src/\u0027+f,\u0027dist/src/\u0027+f))\"",
                    "start":  "pnpm prisma:migrate:deploy \u0026\u0026 node dist/src/main.js",
                    "lint":  "eslint --ignore-pattern generated/** --ignore-pattern dist/** --ext .ts .",
                    "typecheck":  "pnpm prisma:generate \u0026\u0026 tsc --noEmit -p tsconfig.json",
                    "test":  "node --test src/*.spec.mjs \u0026\u0026 tsx --test src/*.spec.ts",
                    "prisma:generate":  "prisma generate",
                    "prisma:migrate:deploy":  "prisma migrate deploy"
                },
    "dependencies":  {
                         "@invitaflow/design-document":  "workspace:*",
                         "@nestjs/common":  "11.2.4",
                         "@nestjs/core":  "11.2.4",
                         "@nestjs/platform-fastify":  "11.2.4",
                         "@prisma/adapter-pg":  "7.10.0",
                         "@prisma/client":  "7.10.0",
                         "fastify":  "5.12.5",
                         "jose":  "6.2.12",
                         "pg":  "8.16.3",
                    "prisma":  "7.10.0",
                         "reflect-metadata":  "0.2.2",
                         "rxjs":  "7.8.2"
                     },
    "devDependencies":  {
                            "@types/node":  "24.5.2",
                            "@types/pg":  "8.15.5",
                            "dotenv":  "18.0.5",
                            "eslint":  "8.57.1",
                            "eslint-config-next":  "15.5.26",
                                    "tsx":  "4.20.5",
                            "typescript":  "5.9.2"
                        }
}
