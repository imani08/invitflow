generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model PriceSchedule {
  id          String       @id @default(uuid()) @db.Uuid
  version     Int          @unique
  effectiveAt DateTime     @map("effective_at") @db.Timestamptz(3)
  createdBy   String       @map("created_by") @db.VarChar(255)
  changeReason String      @map("change_reason") @db.VarChar(500)
  taxPolicyEnabled Boolean @default(false) @map("tax_policy_enabled")
  taxRuleCode String?      @map("tax_rule_code") @db.VarChar(80)
  taxRateBps Int           @default(0) @map("tax_rate_bps")
  idempotencyKey String    @unique @map("idempotency_key") @db.VarChar(255)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  packs       CreditPack[]
  rules       PriceRule[]

  @@index([effectiveAt(sort: Desc)], map: "billing_price_schedules_effective_idx")
  @@map("price_schedules")
}

model CreditPack {
  id               String        @id @default(uuid()) @db.Uuid
  scheduleId       String        @map("schedule_id") @db.Uuid
  key              String        @db.VarChar(60)
  name             String        @db.VarChar(100)
    credits          Int
    periodDays       Int?          @map("period_days")
  priceMinor       Int           @map("price_minor")
  currency         String        @db.Char(3)
  description      String        @default("") @db.VarChar(1000)
  segment          String        @default("INDIVIDUAL") @db.VarChar(30)
  displayOrder     Int           @default(0) @map("display_order")
  badge            String?       @db.VarChar(40)
  validFrom        DateTime?     @map("valid_from") @db.Timestamptz(3)
  validUntil       DateTime?     @map("valid_until") @db.Timestamptz(3)
  visible          Boolean       @default(true)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  schedule         PriceSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)

  @@unique([scheduleId, key], map: "billing_credit_packs_schedule_key")
  @@index([scheduleId, credits], map: "billing_credit_packs_catalog_idx")
  @@map("credit_packs")
}

model PriceRule {
  id          String        @id @default(uuid()) @db.Uuid
  scheduleId  String        @map("schedule_id") @db.Uuid
  operation   String        @db.VarChar(120)
  creditCost  Int           @map("credit_cost")
  unit        String        @db.VarChar(60)
  schedule    PriceSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)

  @@unique([scheduleId, operation], map: "billing_price_rules_schedule_operation_key")
  @@map("price_rules")
}

model OutboxMessage {
  id          String    @id @default(uuid()) @db.Uuid
  eventType   String    @map("event_type") @db.VarChar(100)
  aggregateId String    @map("aggregate_id") @db.Uuid
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  attempts    Int       @default(0)

  @@index([publishedAt, createdAt], map: "billing_outbox_pending_idx")
  @@map("outbox_messages")
}
