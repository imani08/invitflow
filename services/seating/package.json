{
  "name": "@invitaflow/seating",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm prisma:generate && pnpm prisma:migrate:deploy && tsx watch src/main.ts",
    "build": "pnpm prisma:generate && tsc -p tsconfig.json",
    "start": "pnpm prisma:migrate:deploy && node dist/src/main.js",
    "lint": "eslint --ignore-pattern generated/** --ignore-pattern dist/** --ext .ts .",
    "test": "tsx --test src/*.spec.ts",
    "typecheck": "pnpm prisma:generate && tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.0",
    "@nestjs/common": "11.2.4",
    "@nestjs/core": "11.2.4",
    "@nestjs/platform-fastify": "11.2.4",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "csv-parse": "7.0.3",
    "exceljs": "4.4.0",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "prisma": "7.10.0"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "@types/pg": "8.15.5",
    "dotenv": "18.0.5",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.26",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}