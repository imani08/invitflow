generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum CeremonyStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum AgencyRole {
  OWNER
  ADMIN
  MEMBER
}

enum AgencyMemberStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum AgencyWorkspaceStatus {
  ACTIVE
  SUSPENDED
}

enum AgencySubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum AgencyQuotaReservationStatus {
  RESERVED
  CONSUMED
  RELEASED
}

model Event {
  id          String       @id @default(uuid()) @db.Uuid
  ownerSubject String      @map("owner_subject") @db.VarChar(255)
  name        String       @db.VarChar(120)
  description String?      @db.VarChar(4000)
  eventType   String       @map("event_type") @db.VarChar(40)
  status      EventStatus  @default(DRAFT)
  startAt     DateTime?    @map("start_at") @db.Timestamptz(3)
  endAt       DateTime?    @map("end_at") @db.Timestamptz(3)
  timezone    String       @default("Africa/Kinshasa") @db.VarChar(100)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  ceremonies  Ceremony[]
  agencyWorkspaceId String? @map("agency_workspace_id") @db.Uuid
  agencyWorkspace AgencyWorkspace? @relation("AgencyWorkspaceEvents", fields: [agencyWorkspaceId], references: [id], onDelete: SetNull)
  agencyUsageReservations AgencyQuotaReservation[]
  agencyClientEvents AgencyClientEvent[]

  @@index([ownerSubject, createdAt(sort: Desc)], map: "events_owner_created_idx")
  @@unique([id, agencyWorkspaceId], map: "events_id_agency_workspace_key")
  @@map("events")
}

model Ceremony {
  id          String         @id @default(uuid()) @db.Uuid
  eventId     String         @map("event_id") @db.Uuid
  name        String         @db.VarChar(120)
  ceremonyType String        @map("ceremony_type") @db.VarChar(40)
  description String?        @db.VarChar(2000)
  location    String?        @db.VarChar(300)
  address     String?        @db.VarChar(500)
  latitude    Float?         @db.DoublePrecision
  longitude   Float?         @db.DoublePrecision
  instructions String?       @db.VarChar(4000)
  dressCode   String?        @map("dress_code") @db.VarChar(200)
  notes       String?        @db.VarChar(2000)
  capacity    Int?
  startAt     DateTime       @map("start_at") @db.Timestamptz(3)
  endAt       DateTime?      @map("end_at") @db.Timestamptz(3)
  timezone    String         @default("Africa/Kinshasa") @db.VarChar(100)
  status      CeremonyStatus @default(SCHEDULED)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  event       Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  programItems CeremonyProgramItem[]

  @@unique([id, eventId], map: "ceremonies_id_event_id_key")
  @@index([eventId, startAt], map: "ceremonies_event_start_idx")
  @@map("ceremonies")
}

model CeremonyProgramItem {
  id              String   @id @default(uuid()) @db.Uuid
  ceremonyId      String   @map("ceremony_id") @db.Uuid
  position        Int
  title           String   @db.VarChar(120)
  description     String?  @db.VarChar(1000)
  location        String?  @db.VarChar(300)
  startsAt        DateTime? @map("starts_at") @db.Timestamptz(3)
  durationMinutes Int?     @map("duration_minutes")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  ceremony        Ceremony @relation(fields: [ceremonyId], references: [id], onDelete: Cascade)

  @@unique([ceremonyId, position], map: "ceremony_program_items_ceremony_position_key")
  @@index([ceremonyId, position], map: "ceremony_program_items_order_idx")
  @@map("ceremony_program_items")
}

model OutboxMessage {
  id          String   @id @default(uuid()) @db.Uuid
  eventType   String   @map("event_type") @db.VarChar(100)
  aggregateId String   @map("aggregate_id") @db.Uuid
  payload     Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  attempts    Int      @default(0)

  @@index([publishedAt, createdAt], map: "outbox_pending_idx")
  @@map("outbox_messages")
}

model AgencyWorkspace {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(120)
  ownerSubject String  @map("owner_subject") @db.VarChar(255)
  status      AgencyWorkspaceStatus @default(ACTIVE)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships AgencyMembership[]
  auditEntries AgencyAuditEntry[]
  clients     AgencyClient[]
  events      Event[] @relation("AgencyWorkspaceEvents")
  subscriptions AgencySubscription[]
  usageReservations AgencyQuotaReservation[]

  @@index([ownerSubject, createdAt(sort: Desc)], map: "agency_workspaces_owner_created_idx")
  @@map("agency_workspaces")
}

model AgencyMembership {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  subject     String   @db.VarChar(255)
  role        AgencyRole @default(MEMBER)
  status      AgencyMemberStatus @default(ACTIVE)
  addedBy     String   @map("added_by") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace   AgencyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, subject], map: "agency_memberships_workspace_subject_key")
  @@index([subject, status], map: "agency_memberships_subject_status_idx")
  @@map("agency_memberships")
}

model AgencyAuditEntry {
  id            String          @id @default(uuid()) @db.Uuid
  workspaceId   String          @map("workspace_id") @db.Uuid
  actorSubject  String          @map("actor_subject") @db.VarChar(255)
  targetSubject String?         @map("target_subject") @db.VarChar(255)
  action        String          @db.VarChar(80)
  before        Json?
  after         Json?
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace     AgencyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  @@index([workspaceId, createdAt(sort: Desc)], map: "agency_audit_workspace_created_idx")
  @@map("agency_audit_entries")
}

model AgencyClient {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String   @db.VarChar(120)
  email       String?  @db.VarChar(320)
  phone       String?  @db.VarChar(40)
  createdBy   String   @map("created_by") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace   AgencyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  events      AgencyClientEvent[]

  @@unique([id, workspaceId], map: "agency_clients_id_workspace_key")
  @@index([workspaceId, createdAt(sort: Desc)], map: "agency_clients_workspace_created_idx")
  @@map("agency_clients")
}

model AgencyClientEvent {
  workspaceId String @map("workspace_id") @db.Uuid
  clientId    String @map("client_id") @db.Uuid
  eventId     String @map("event_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  client      AgencyClient @relation(fields: [clientId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  event       Event @relation(fields: [eventId, workspaceId], references: [id, agencyWorkspaceId], onDelete: Cascade)

  @@id([workspaceId, clientId, eventId], map: "agency_client_events_pkey")
  @@index([workspaceId, eventId], map: "agency_client_events_event_idx")
  @@map("agency_client_events")
}

model AgencySubscription {
  id                  String   @id @default(uuid()) @db.Uuid
  workspaceId         String   @map("workspace_id") @db.Uuid
  planPackId          String   @map("plan_pack_id") @db.Uuid
  planKey             String   @map("plan_key") @db.VarChar(60)
  planName            String   @map("plan_name") @db.VarChar(100)
  quotaCredits        Int      @map("quota_credits")
  priceMinor          Int      @map("price_minor")
  currency            String   @db.Char(3)
  priceScheduleId     String   @map("price_schedule_id") @db.Uuid
  priceScheduleVersion Int     @map("price_schedule_version")
  currentPlanVersion   Int     @default(1) @map("current_plan_version")
  periodDays           Int?    @map("period_days")
  renewalOfId          String? @map("renewal_of_id") @db.Uuid
  renewalOf            AgencySubscription? @relation("AgencySubscriptionPeriods", fields: [renewalOfId], references: [id], onDelete: Restrict)
  renewedPeriods       AgencySubscription[] @relation("AgencySubscriptionPeriods")
  status              AgencySubscriptionStatus @default(PENDING)
  paymentOrderId      String?  @unique @map("payment_order_id") @db.Uuid
  paymentId           String?  @unique @map("payment_id") @db.Uuid
  billingPeriodStart  DateTime? @map("billing_period_start") @db.Timestamptz(3)
  billingPeriodEnd    DateTime? @map("billing_period_end") @db.Timestamptz(3)
  startsAt            DateTime? @map("starts_at") @db.Timestamptz(3)
  endsAt              DateTime? @map("ends_at") @db.Timestamptz(3)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace           AgencyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  quotaReservations   AgencyQuotaReservation[]

  @@index([workspaceId, createdAt(sort: Desc)], map: "agency_subscriptions_workspace_created_idx")
  @@map("agency_subscriptions")
}

model AgencyQuotaReservation {
  id           String @id @default(uuid()) @db.Uuid
  subscriptionId String? @map("subscription_id") @db.Uuid
  workspaceId  String @map("workspace_id") @db.Uuid
  eventId      String @map("event_id") @db.Uuid
  referenceKey String @unique @map("reference_key") @db.VarChar(255)
  credits      Int
  status       AgencyQuotaReservationStatus @default(RESERVED)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace    AgencyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscription AgencySubscription? @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  event        Event @relation(fields: [eventId, workspaceId], references: [id, agencyWorkspaceId], onDelete: Cascade)

  @@index([workspaceId, status], map: "agency_quota_reservations_usage_idx")
  @@map("agency_quota_reservations")
}
