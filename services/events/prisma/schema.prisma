generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum CeremonyStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

model Event {
  id          String       @id @default(uuid()) @db.Uuid
  ownerSubject String      @map("owner_subject") @db.VarChar(255)
  name        String       @db.VarChar(120)
  description String?      @db.VarChar(4000)
  eventType   String       @map("event_type") @db.VarChar(40)
  status      EventStatus  @default(DRAFT)
  startAt     DateTime?    @map("start_at") @db.Timestamptz(3)
  endAt       DateTime?    @map("end_at") @db.Timestamptz(3)
  timezone    String       @default("Africa/Kinshasa") @db.VarChar(100)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  ceremonies  Ceremony[]

  @@index([ownerSubject, createdAt(sort: Desc)], map: "events_owner_created_idx")
  @@map("events")
}

model Ceremony {
  id          String         @id @default(uuid()) @db.Uuid
  eventId     String         @map("event_id") @db.Uuid
  name        String         @db.VarChar(120)
  ceremonyType String        @map("ceremony_type") @db.VarChar(40)
  description String?        @db.VarChar(2000)
  location    String?        @db.VarChar(300)
  address     String?        @db.VarChar(500)
  latitude    Float?         @db.DoublePrecision
  longitude   Float?         @db.DoublePrecision
  instructions String?       @db.VarChar(4000)
  dressCode   String?        @map("dress_code") @db.VarChar(200)
  notes       String?        @db.VarChar(2000)
  capacity    Int?
  startAt     DateTime       @map("start_at") @db.Timestamptz(3)
  endAt       DateTime?      @map("end_at") @db.Timestamptz(3)
  timezone    String         @default("Africa/Kinshasa") @db.VarChar(100)
  status      CeremonyStatus @default(SCHEDULED)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  event       Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([id, eventId], map: "ceremonies_id_event_id_key")
  @@index([eventId, startAt], map: "ceremonies_event_start_idx")
  @@map("ceremonies")
}

model OutboxMessage {
  id          String   @id @default(uuid()) @db.Uuid
  eventType   String   @map("event_type") @db.VarChar(100)
  aggregateId String   @map("aggregate_id") @db.Uuid
  payload     Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  attempts    Int      @default(0)

  @@index([publishedAt, createdAt], map: "outbox_pending_idx")
  @@map("outbox_messages")
}
