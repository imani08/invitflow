generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentStatus {
  CREATED
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
  REFUND_PENDING
  REFUNDED
}

enum OrderStatus {
  CREATED
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentOrderType {
  CREDIT_PURCHASE
  AGENCY_SUBSCRIPTION
}

enum PartnerStatus {
  PENDING
  ACTIVE
  SUSPENDED
}
enum PartnerAttributionStatus {
  ACTIVE
  REVOKED
}
enum CommissionLedgerStatus {
  PENDING
  VALIDATED
  PAYABLE
  PAID
  REVERSED
  DISPUTED
}
enum PartnerPayoutStatus {
  PENDING
  APPROVED
  PROCESSING
  PAID
  REJECTED
}

model PaymentOrder {
  id                String        @id @default(uuid()) @db.Uuid
  orderType         PaymentOrderType @default(CREDIT_PURCHASE) @map("order_type")
  businessReference String?       @map("business_reference") @db.VarChar(255)
  metadata          Json?          @db.JsonB
  ownerSubject      String        @map("owner_subject") @db.VarChar(255)
  packId            String        @map("pack_id") @db.Uuid
  packKey           String        @map("pack_key") @db.VarChar(60)
  packName          String        @map("pack_name") @db.VarChar(100)
  credits           Int
  unitCredits       Int           @map("unit_credits")
  quantity          Int           @default(1)
  unitPriceMinor    Int           @map("unit_price_minor")
  discountMinor     Int           @default(0) @map("discount_minor")
  discountRule      String?       @map("discount_rule") @db.VarChar(120)
  taxEnabled        Boolean       @default(false) @map("tax_enabled")
  taxRule           String?       @map("tax_rule") @db.VarChar(80)
  taxRateBps        Int           @default(0) @map("tax_rate_bps")
  taxMinor          Int           @default(0) @map("tax_minor")
  subtotalMinor     Int           @map("subtotal_minor")
  totalMinor        Int           @map("total_minor")
  amountMinor       Int           @map("amount_minor")
  currency          String        @db.Char(3)
  priceScheduleId   String        @map("price_schedule_id") @db.Uuid
  priceScheduleVersion Int        @map("price_schedule_version")
  idempotencyKey    String        @map("idempotency_key") @db.VarChar(255)
  salesTermsVersion String?       @map("sales_terms_version") @db.VarChar(20)
  refundPolicyVersion String?     @map("refund_policy_version") @db.VarChar(20)
  salesTermsAcceptedAt DateTime?  @map("sales_terms_accepted_at") @db.Timestamptz(3)
  refundPolicyAcceptedAt DateTime? @map("refund_policy_accepted_at") @db.Timestamptz(3)
  status            OrderStatus  @default(CREATED)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  payment           Payment?
  commissionLedgerEntries CommissionLedgerEntry[]

  @@unique([ownerSubject, idempotencyKey], map: "payment_orders_owner_idempotency_key")
  @@index([ownerSubject, createdAt(sort: Desc)], map: "payment_orders_owner_created_idx")
  @@map("payment_orders")
}

model Payment {
  id                    String        @id @default(uuid()) @db.Uuid
  orderId               String        @unique @map("order_id") @db.Uuid
  provider              String        @db.VarChar(40)
  status                PaymentStatus @default(CREATED)
  checkoutUrl           String?       @map("checkout_url") @db.VarChar(2048)
  providerOrderRef      String?       @map("provider_order_ref") @db.VarChar(16)
  providerStatus        String?       @map("provider_status") @db.VarChar(80)
  providerTransactionId String?       @unique @map("provider_transaction_id") @db.VarChar(255)
  providerReference     String?       @map("provider_reference") @db.VarChar(255)
  providerRefundId      String?       @map("provider_refund_id") @db.VarChar(255)
  failureCode           String?       @map("failure_code") @db.VarChar(100)
  paidAt                DateTime?     @map("paid_at") @db.Timestamptz(3)
  reconciliationAttemptAt DateTime?   @map("reconciliation_attempt_at") @db.Timestamptz(3)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  order                 PaymentOrder  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  reconciliationIssues  PaymentReconciliationIssue[]
  commissionLedgerEntries CommissionLedgerEntry[]

  @@index([status, reconciliationAttemptAt], map: "payments_status_reconciled_idx")
  @@unique([provider, providerOrderRef], map: "payments_provider_order_ref_key")
  @@map("payments")
}

model Partner {
  id                 String              @id @default(uuid()) @db.Uuid
  ownerSubject       String?             @unique @map("owner_subject") @db.VarChar(255)
  code               String              @unique @db.VarChar(60)
  status             PartnerStatus       @default(PENDING)
  commissionRateBps  Int                 @map("commission_rate_bps")
  eligibleOrderTypes PaymentOrderType[]  @default([]) @map("eligible_order_types")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  attributions       ReferralAttribution[]
  ledgerEntries      CommissionLedgerEntry[]
  payouts            PartnerPayout[]
  auditEntries       PartnerAuditEntry[]
  @@map("partners")
}

model ReferralAttribution {
  id              String                    @id @default(uuid()) @db.Uuid
  partnerId       String                    @map("partner_id") @db.Uuid
  customerSubject String                    @unique @map("customer_subject") @db.VarChar(255)
  source          String                    @db.VarChar(20)
  codeSnapshot    String                    @map("code_snapshot") @db.VarChar(60)
  status          PartnerAttributionStatus  @default(ACTIVE)
  attributedAt    DateTime                  @default(now()) @map("attributed_at") @db.Timestamptz(3)
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  partner         Partner                   @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  ledgerEntries   CommissionLedgerEntry[]
  @@index([partnerId, status, attributedAt(sort: Desc)], map: "referral_attributions_partner_idx")
  @@map("referral_attributions")
}

model CommissionLedgerEntry {
  id                    String                 @id @default(uuid()) @db.Uuid
  partnerId             String                 @map("partner_id") @db.Uuid
  attributionId         String?                @map("attribution_id") @db.Uuid
  paymentId             String                 @map("payment_id") @db.Uuid
  originalPaymentId     String?                @unique @map("original_payment_id") @db.Uuid
  orderId               String                 @map("order_id") @db.Uuid
  originalEntryId       String?                @unique @map("original_entry_id") @db.Uuid
  status                CommissionLedgerStatus @default(PENDING)
  orderType             PaymentOrderType       @map("order_type")
  baseAmountMinor       Int                    @map("base_amount_minor")
  commissionAmountMinor Int                    @map("commission_amount_minor")
  rateBpsSnapshot       Int                    @map("rate_bps_snapshot")
  currency              String                 @db.Char(3)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  partner               Partner                @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  attribution           ReferralAttribution?   @relation(fields: [attributionId], references: [id], onDelete: Restrict)
  payment               Payment                @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  order                 PaymentOrder           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  originalEntry         CommissionLedgerEntry? @relation("CommissionReversal", fields: [originalEntryId], references: [id], onDelete: Restrict)
  reversal              CommissionLedgerEntry? @relation("CommissionReversal")
  payoutLinks           PartnerPayoutCommission[]
  @@index([partnerId, status, createdAt(sort: Desc)], map: "commission_ledger_partner_status_idx")
  @@map("commission_ledger_entries")
}

model PartnerPayout {
  id                 String            @id @default(uuid()) @db.Uuid
  partnerId          String            @map("partner_id") @db.Uuid
  amountMinor        Int               @map("amount_minor")
  currency           String            @db.Char(3)
  status             PartnerPayoutStatus @default(PENDING)
  externalReference  String?           @map("external_reference") @db.VarChar(255)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  partner            Partner           @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  commissions        PartnerPayoutCommission[]
  @@index([partnerId, createdAt(sort: Desc)], map: "partner_payouts_partner_created_idx")
  @@map("partner_payouts")
}

model PartnerPayoutCommission {
  payoutId          String                @map("payout_id") @db.Uuid
  commissionEntryId String                @map("commission_entry_id") @db.Uuid
  payout            PartnerPayout         @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  commissionEntry   CommissionLedgerEntry @relation(fields: [commissionEntryId], references: [id], onDelete: Restrict)
  @@id([payoutId, commissionEntryId])
  @@unique([commissionEntryId])
  @@map("partner_payout_commissions")
}

model PartnerAuditEntry {
  id           String   @id @default(uuid()) @db.Uuid
  partnerId    String   @map("partner_id") @db.Uuid
  actorSubject String   @map("actor_subject") @db.VarChar(255)
  action       String   @db.VarChar(80)
  before       Json?
  after        Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  partner      Partner  @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  @@index([partnerId, createdAt(sort: Desc)], map: "partner_audit_partner_created_idx")
  @@map("partner_audit_entries")
}

model WebhookReceipt {
  id          String   @id @default(uuid()) @db.Uuid
  provider    String   @db.VarChar(40)
  eventHash   String   @map("event_hash") @db.Char(64)
  receivedAt  DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@unique([provider, eventHash], map: "payment_webhook_receipts_provider_hash_key")
  @@index([receivedAt], map: "payment_webhook_receipts_received_idx")
  @@map("payment_webhook_receipts")
}

model PaymentReconciliationIssue {
  id               String    @id @default(uuid()) @db.Uuid
  paymentId        String    @map("payment_id") @db.Uuid
  fingerprint      String    @unique @db.Char(64)
  internalStatus   String    @map("internal_status") @db.VarChar(40)
  providerStatus   String    @map("provider_status") @db.VarChar(80)
  firstSeenAt      DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  occurrences      Int       @default(1)
  resolvedAt       DateTime? @map("resolved_at") @db.Timestamptz(3)
  payment          Payment   @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([resolvedAt, lastSeenAt(sort: Desc)], map: "payment_reconciliation_open_idx")
  @@index([paymentId, resolvedAt], map: "payment_reconciliation_payment_idx")
  @@map("payment_reconciliation_issues")
}

model OutboxMessage {
  id          String    @id @default(uuid()) @db.Uuid
  eventType   String    @map("event_type") @db.VarChar(100)
  aggregateId String    @map("aggregate_id") @db.Uuid
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  attempts    Int       @default(0)

  @@index([publishedAt, createdAt], map: "payment_outbox_pending_idx")
  @@map("outbox_messages")
}
