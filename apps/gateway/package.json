{
  "name": "@invitaflow/gateway",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint --ignore-pattern next-env.d.ts --ignore-pattern dist/** .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "tsx --test src/http-metrics.spec.ts"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.0",
    "@nestjs/common": "11.2.4",
    "@nestjs/core": "11.2.4",
    "@nestjs/platform-fastify": "11.2.4",
    "fastify": "5.12.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.26",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
