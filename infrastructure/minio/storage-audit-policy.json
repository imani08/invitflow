{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::media",
        "arn:aws:s3:::media-quarantine",
        "arn:aws:s3:::previews",
        "arn:aws:s3:::generated",
        "arn:aws:s3:::temporary",
        "arn:aws:s3:::invitations"
      ]
    }
  ]
}
