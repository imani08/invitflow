      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "expr": "up{job=\"postgres-exporter\"}",
          "legendFormat": "PostgreSQL exporter scrape",
          "refId": "A"
        },
        {
          "expr": "1 - pg_exporter_last_scrape_error",
