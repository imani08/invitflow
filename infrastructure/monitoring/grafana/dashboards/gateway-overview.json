      },
      "targets": [
        {
          "expr": "sum by (status_code) (rate(invitaflow_http_requests_total[5m]))",
          "legendFormat": "{{status_code}}",
          "refId": "A"
        }
      ],
      "title": "Requêtes HTTP par statut",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "invitaflow-prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
