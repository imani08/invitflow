          "refId": "B"
        }
      ],
      "title": "Disponibilité des métriques PostgreSQL",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "invitaflow-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.8 },
              { "color": "red", "value": 0.95 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 38 },
      "id": 9,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "expr": "sum(pg_stat_activity_count{job=\"postgres-exporter\"}) / max(pg_settings_max_connections{job=\"postgres-exporter\"})",
          "legendFormat": "Connexions utilisées",
          "refId": "A"
        }
      ],
      "title": "Utilisation de la capacité de connexions PostgreSQL",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "invitaflow-prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
