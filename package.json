{
  "name": "invitaflow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.8.0",
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=12.8.0 <13"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test && node --test scripts/*.spec.mjs services/media/*.spec.mjs infrastructure/keycloak/*.test.mjs",
    "check:workspace": "node scripts/validate-workspace.mjs",
    "db:backup": "node scripts/backup-postgres.mjs",
    "db:restore": "node scripts/restore-postgres.mjs",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "turbo": "2.5.6",
    "typescript": "5.9.2"
  }
}
